# 模型提供商（默认 DeepSeek，可替换为其他 OpenAI-compatible 服务）
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_EXTRA_BODY_JSON={}

# 仅在主动运行真实 API 冒烟测试时设为 1；会产生请求和费用
RUN_LIVE_LLM_TESTS=0

# 本地 Web 服务
CODEAGENT_HOST=127.0.0.1
CODEAGENT_PORT=8000
CODEAGENT_ALLOWED_ORIGINS=http://127.0.0.1:5173
